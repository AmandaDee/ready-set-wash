# Copy to .env; never commit your actual credentials.
READY_SET_WASH_MODE=demo
# For live mode, copy the exact product/tariff codes from Octopus API docs.
READY_SET_WASH_PRODUCT_CODE=
READY_SET_WASH_TARIFF_CODE=
# Public prices do not require this key. Reserved for authenticated integrations.
READY_SET_WASH_OCTOPUS_API_KEY=
